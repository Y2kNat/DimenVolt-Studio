# Puppeteer não baixa o Chrome durante a pós-instalação:
# - Termux/Android não tem build oficial do Chromium;
# - produção usa @sparticuz/chromium + puppeteer-core e não depende dele.
# Para gerar PDF local em desktop, aponte PUPPETEER_EXECUTABLE_PATH
# para um Chromium instalado.
puppeteer_skip_download=true
